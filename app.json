{
  "expo": {
    "name": "encuadre",
    "slug": "encuadre",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.encuadre.app",
      "buildNumber": "11",
      "infoPlist": {
        "NSCameraUsageDescription": "Encuadre uses the camera to see your live scene and explain the light to you as you learn. Nothing is saved or sent to any server.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.encuadre.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Encuadre usa la cámara para ver tu escena en vivo y explicarte la luz mientras aprendes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "e126288c-7505-4ca4-a7c5-9483a5f15921"
      }
    },
    "owner": "yeriklinares",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e126288c-7505-4ca4-a7c5-9483a5f15921"
    },
    "locales": {
      "en": "./ios-locales/en.json",
      "es": "./ios-locales/es.json",
      "pt": "./ios-locales/pt.json"
    }
  }
}
